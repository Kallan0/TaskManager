NODE_ENV=development
PORT=5000
# Keep 0 for direct access. Set only to your known, fixed reverse-proxy hop count.
TRUST_PROXY_HOPS=0
MONGODB_URI=mongodb://127.0.0.1:27017/team_task_planner
CLIENT_URL=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters
# Invitations return a shareable link and expire 48 hours after creation.
