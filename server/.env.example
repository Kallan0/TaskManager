NODE_ENV=development
PORT=5000
# Keep 0 for direct access. Set only to your known, fixed reverse-proxy hop count.
TRUST_PROXY_HOPS=0
# Set true only after verifying all public ingress paths and header replacement.
PROXY_TRUST_CONFIRMED=false
# Per API process; budget across replicas and rolling deployment overlap.
DB_POOL_SIZE=20
MONGODB_URI=mongodb://127.0.0.1:27017/team_task_planner
CLIENT_URL=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters
# Invitations return a 48-hour link. Joining requires Celestial identity confirmation.
# MongoDB must be a replica set. Production requires a controlled db:migrate.
